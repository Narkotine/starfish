# Writes git_sha.h (STARFISH_GIT_SHA) at every build, touching it only when the
# commit changes. Run by the starfish_git_sha target: cmake -DSRC=... -DOUT=... -P
execute_process(COMMAND git rev-parse --short=7 HEAD WORKING_DIRECTORY "${SRC}"
                OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR sha STREQUAL "")
    set(sha "unknown")
else()
    execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SRC}"
                    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT dirty STREQUAL "")
        string(APPEND sha "-dirty")
    endif()
endif()
set(content "#pragma once\n// Generated by src/git_sha.cmake -- do not edit.\n#define STARFISH_GIT_SHA \"${sha}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
