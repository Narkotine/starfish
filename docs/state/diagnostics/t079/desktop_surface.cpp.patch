+QString DesktopSurface::screenSample() const
+{
+    // TEMPORARY diagnostic (removed before the commit).
+    const HDC dc = ::GetDC(nullptr);
+    const COLORREF colour = ::GetPixel(dc, m_rect.center().x(), m_rect.center().y());
+    ::ReleaseDC(nullptr, dc);
+    if (colour == CLR_INVALID)
+        return QStringLiteral("(unreadable)");
+    return QStringLiteral("#%1%2%3")
+        .arg(GetRValue(colour), 2, 16, QLatin1Char('0'))
+        .arg(GetGValue(colour), 2, 16, QLatin1Char('0'))
+        .arg(GetBValue(colour), 2, 16, QLatin1Char('0'));
